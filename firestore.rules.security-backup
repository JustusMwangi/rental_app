rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validNormalRole(role) {
      return role in ['tenant', 'landlord', 'agent'];
    }

    match /users/{userId} {

      // A user may create only their own profile and cannot
      // register themselves as an administrator.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && validNormalRole(request.resource.data.role)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'role'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'role', 'createdAt', 'phone'
        ]);

      // Users can read their own profile.
      // Admin access is based on the existing trusted role.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin'
        );

      // Users may update their own phone number only.
      // Existing role, UID and email cannot be changed here.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30;

      // No client may delete user profiles.
      allow delete: if false;
    }

    // Keep every other collection denied until its own
    // authorization rules and tests are ready.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}