.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ==========================================
# KejaFind Custom Additions (Security & Secrets)
# ==========================================

# Android Signing Keys (Do not upload to GitHub)
*.jks
*.keystore
android/key.properties
android/local.properties

# iOS signing
ios/*.mobileprovision
ios/*.p12

# Environment variables
.env
.env.*

# Keep the firebase_options.dart safe if you add it to gitignore later,
# but for now, it's fine to commit since it doesn't contain secret keys.
# ==========================================
# KejaFind Git Cleanup
# ==========================================

# Backups
*.backup
*.backup-*
lib/*.backup

# Audit / Log files
audit-*.txt
*.log

# Node modules (if you ever use Firebase CLI or web tools)
node_modules/
package-lock.json
package.json

# Keep the storage rules, but ignore the backups
storage.rules.backup*
firestore.rules.backup*

# Test temporary folders
tests/